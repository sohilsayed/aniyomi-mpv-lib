+static int mp_property_sub_geometry(void *ctx, struct m_property *prop,
+                                    int action, void *arg)
+{
+    MPContext *mpctx = ctx;
+    int sub_index = *(int *)prop->priv;
+
+    struct track *track = mpctx->current_track[sub_index][STREAM_SUB];
+    struct dec_sub *sub = track ? track->d_sub : NULL;
+    double pts = mpctx->playback_pts;
+    if (!sub || pts == MP_NOPTS_VALUE)
+        return M_PROPERTY_UNAVAILABLE;
+
+    switch (action) {
+    case M_PROPERTY_GET: {
+        struct mp_osd_res res = osd_get_vo_res(mpctx->osd);
+        if (res.w <= 0 || res.h <= 0)
+            return M_PROPERTY_UNAVAILABLE;
+
+        struct sub_bitmaps *imgs = sub_get_bitmaps(sub, res, SUBBITMAP_LIBASS, pts);
+
+        char *text = sub_get_text(sub, pts, SD_TEXT_TYPE_PLAIN);
+        if (!text)
+            text = talloc_strdup(NULL, "");
+
+        struct mpv_node root;
+        node_init(&root, MPV_FORMAT_NODE_MAP, NULL);
+        node_map_add_int64(&root, "w", res.w);
+        node_map_add_int64(&root, "h", res.h);
+        node_map_add_string(&root, "text", text);
+
+        struct mpv_node *glyphs = node_map_add(&root, "glyphs", MPV_FORMAT_NODE_ARRAY);
+        if (imgs) {
+            for (int n = 0; n < imgs->num_parts; n++) {
+                struct sub_bitmap *b = &imgs->parts[n];
+                struct mpv_node *g = node_array_add(glyphs, MPV_FORMAT_NODE_MAP);
+                node_map_add_int64(g, "x", b->x);
+                node_map_add_int64(g, "y", b->y);
+                node_map_add_int64(g, "w", b->dw);
+                node_map_add_int64(g, "h", b->dh);
+            }
+            talloc_free(imgs);
+        }
+
+        char *json = NULL;
+        json_write(&json, &root);
+        talloc_free(root.u.list);
+
+        if (!json)
+            json = talloc_strdup(NULL, "");
+
+        *(char **)arg = json;
+        talloc_free(text);
+        return M_PROPERTY_OK;
+    }
+    case M_PROPERTY_GET_TYPE:
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_STRING};
+        return M_PROPERTY_OK;
+    }
+    return M_PROPERTY_NOT_IMPLEMENTED;
+}
