+static void cmd_sub_highlight(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+
+    int x = cmd->args[0].v.i;
+    int y = cmd->args[1].v.i;
+    int w = cmd->args[2].v.i;
+    int h = cmd->args[3].v.i;
+    int r = cmd->args[4].v.i;
+    int g = cmd->args[5].v.i;
+    int b = cmd->args[6].v.i;
+    int a = cmd->args[7].v.i;
+
+    r = MPCLAMP(r, 0, 255);
+    g = MPCLAMP(g, 0, 255);
+    b = MPCLAMP(b, 0, 255);
+    a = MPCLAMP(a, 0, 255);
+
+    // A zero/negative size clears the highlight.
+    if (w <= 0 || h <= 0) {
+        osd_set_external2(mpctx->osd, NULL);
+        mp_wakeup_core(mpctx);
+        return;
+    }
+
+    struct mp_image *packed = mp_image_alloc(IMGFMT_BGRA, w, h);
+    if (!packed) {
+        cmd->success = false;
+        return;
+    }
+
+    uint8_t pr = r * a / 255;
+    uint8_t pg = g * a / 255;
+    uint8_t pb = b * a / 255;
+    for (int yy = 0; yy < h; yy++) {
+        uint8_t *dst = packed->planes[0] + yy * packed->stride[0];
+        for (int xx = 0; xx < w; xx++) {
+            dst[xx * 4 + 0] = pb;
+            dst[xx * 4 + 1] = pg;
+            dst[xx * 4 + 2] = pr;
+            dst[xx * 4 + 3] = a;
+        }
+    }
+
+    struct sub_bitmaps imgs = {
+        .render_index = OSDTYPE_EXTERNAL2,
+        .format = SUBBITMAP_BGRA,
+        .packed = packed,
+        .packed_w = w,
+        .packed_h = h,
+        .change_id = 1,
+        .num_parts = 1,
+        .parts = &(struct sub_bitmap) {
+            .bitmap = packed->planes[0],
+            .stride = packed->stride[0],
+            .w = w, .h = h,
+            .x = x, .y = y,
+            .dw = w, .dh = h,
+            .src_x = 0, .src_y = 0,
+        },
+    };
+
+    osd_set_external2(mpctx->osd, &imgs);
+    talloc_free(packed);
+    mp_wakeup_core(mpctx);
+}
